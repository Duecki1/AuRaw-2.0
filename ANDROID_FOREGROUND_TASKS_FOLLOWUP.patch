+    assert 'crate::ui::responsive_popup' in LIBRARY_UI
+    assert 'crate::ui::responsive_popup' in MASKS
+    assert 'crate::ui::responsive_popup' in INPAINT
+    assert 'crate::ui::responsive_popup' in RUNTIME
+
