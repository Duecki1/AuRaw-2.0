+                        "auraw-inpaint-result",
+                        image,
+                        egui::TextureOptions::LINEAR,
+                    ));
+                }
+                app.inpaint_texture_key = Some(app.inpaint_texture_revision);
+            }
+            if let Some(texture) = &app.inpaint_texture {
