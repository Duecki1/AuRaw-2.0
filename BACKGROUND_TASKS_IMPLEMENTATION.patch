++    pub(crate) fn release_current(&mut self, id: TaskId) -> bool {
++        if self.current != Some(id) {
++            return false;
++        }
++        let running = self.task(id).is_some_and(|task| {
++            matches!(task.status, TaskStatus::Running | TaskStatus::Cancelling)
++        });
++        if !running {
++            return false;
++        }
++        self.current = None;
