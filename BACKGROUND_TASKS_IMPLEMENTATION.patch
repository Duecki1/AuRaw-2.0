++        let obsolete = self
++            .tasks
++            .iter()
++            .filter(|task| {
++                task.status == TaskStatus::Queued
++                    && matches!(
++                        &task.kind,
++                        TaskKind::LensCorrection {
++                            document_id: existing,
++                            ..
++                        } if *existing == document_id
++                    )
++            })
++            .map(|task| task.id)
++            .collect::<Vec<_>>();
++        for id in &obsolete {
++            self.remove_task(*id);
++        }
++
++        if let Some(current) = self.current {
++            let same_document = self.task(current).is_some_and(|task| {
++                matches!(
++                    &task.kind,
++                    TaskKind::LensCorrection {
++                        document_id: existing,
++                        ..
++                    } if *existing == document_id
++                )
++            });
++            if same_document {
++                let _ = self.request_cancel(current);
++            }
++        }
++
++        let id = self.enqueue(
++            TaskKind::LensCorrection {
++                document_id,
++                generation,
++            },
++            name,
++            initial_progress,
++            details_open,
++        );
